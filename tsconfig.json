{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "contracts/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": [
    "src/lib",
    "src/hooks",
    "src/components",
    "src/App.tsx",
    "src/main.tsx",
    "src/vite-env.d.ts"
  ]
}