# Copy to .env and adjust for your environment.
# All variables are optional — sensible defaults are baked into the app.

# Network the wallet must connect to ('preprod', 'preview', or 'undeployed').
VITE_NETWORK_ID=preprod

# Indexer used to READ public contract state without a wallet.
# The app prefers the URIs reported by the Lace wallet's getConfiguration();
# these only serve as defaults for the public read.
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
VITE_INDEXER_WS_URL=wss://indexer.preprod.midnight.network/api/v4/graphql/ws

# Proof server the app falls back to when the wallet does not report one.
# Lace must be configured with the same URI to submit circuit proofs.
VITE_PROOF_SERVER_URL=http://localhost:6300

# The deployed TenderShield contract on the chosen network (64 hex chars).
# Leave empty to deploy a fresh TenderShield tender from the browser instead.
# NOTE: each TenderShield tender can be AWARDED only once.
VITE_TENDERSHIELD_CONTRACT_ADDRESS=